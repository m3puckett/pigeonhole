# /etc/pigeonhole.conf — sourced by ocr-one.sh and ocr-watch.sh after their
# built-in defaults. Only set what you want to change.

SCANS=/srv/nas/public/scans          # inbox/, originals/, failed/, logs live here
DOCS=/srv/nas/public/documents       # filed output: <Issuer>/<date - type - initials>.pdf

MODEL=qwen2.5:3b                     # any Ollama model; qwen2.5:7b is sharper, slower
#OLLAMA=http://127.0.0.1:11434/api/generate
#KEEP_ALIVE=1h                       # Ollama keeps the model loaded this long after each call (default 5m)

PAR=4                                # documents OCR'd concurrently (watcher)
OCR_JOBS=2                           # tesseract threads per document (PAR*OCR_JOBS ~= cores)
#ROTATE_THRESHOLD=2                  # ocrmypdf rotation confidence; raise if upright pages get flipped
#MIN_READABLE=4                      # OCR text scoring below this (common words per 100) goes to _Unsorted
#MODEL_WAIT=10                       # minutes a worker waits for an unreachable model before giving the file back
#OCR_TMPDIR=/var/tmp/pigeonhole      # ocrmypdf scratch: needs gigabytes free and Ghostscript's AppArmor profile must allow it (/tmp, /var/tmp)
#TEXT_CHARS=3500                     # OCR text shown to the model
#UNSORTED=_Unsorted                  # folder for unclassifiable documents
#DUPS=duplicates                     # folder under $SCANS for re-sent copies of filed scans

#PROMPT=$DOCS/.prompt                # move this off a guest-writable share if you prefer
#ALIASES=$DOCS/.issuers
